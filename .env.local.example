# Rent Hunch — Supabase project (must NOT be the Leasing OS project).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to the client — only referenced from
# lib/supabase/admin.ts and server-side route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret checked by /api/cron/new-challenge (Vercel sets this
# automatically as the Authorization header for its own cron invocations
# when CRON_SECRET is configured as a project env var).
CRON_SECRET=
