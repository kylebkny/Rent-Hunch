# Rent Hunch — Supabase project (must NOT be the Leasing OS project).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to the client — only referenced from
# lib/supabase/admin.ts and server-side route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist of admin emails. A Supabase email/password user
# whose email is listed here gets access to /admin.
ADMIN_EMAILS=

# Optional. Enables address autocomplete + geocoding + nearest-subway lookup
# in the admin. Needs Maps JavaScript API + Places API enabled, and should be
# an HTTP-referrer-restricted browser key. Without it, admin entry is manual.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Web-push "daily reminder" notifications. Generate a keypair with
# `npx web-push generate-vapid-keys`. Without these, the reminder toggle is
# hidden and the cron push is a no-op.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kyle.bkny@gmail.com

# Shared secret checked by /api/cron/new-challenge (Vercel sets this
# automatically as the Authorization header for its own cron invocations
# when CRON_SECRET is configured as a project env var).
CRON_SECRET=
